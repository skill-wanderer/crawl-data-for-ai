GEMINI_API_KEY=your-gemini-api-key-here

# --- Qdrant connection ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=website_pages

# gRPC sends vectors as packed float32 instead of JSON decimal text
# (~12KB vs ~65KB per 3072-dim point). Set true for a remote/tunnelled server
# and make sure QDRANT_GRPC_PORT is reachable (e.g. ssh -L 6334:localhost:6334).
QDRANT_PREFER_GRPC=false
QDRANT_HTTPS=false
QDRANT_API_KEY=

# Request timeout in seconds. The client library's own default is 5s, which is
# far too low for multi-megabyte upserts over a long-haul link.
QDRANT_TIMEOUT=120

# --- Request sizing ---
# Points per upsert request. Lower this if uploads still stall on a slow link;
# it has NO effect on embedding cost (Gemini bills per input token).
QDRANT_UPSERT_BATCH_SIZE=32
# Points per scroll request when aggregating domain stats (payload-only).
QDRANT_SCROLL_BATCH_SIZE=1000

# --- Retry policy (exponential backoff between attempts) ---
QDRANT_MAX_RETRIES=5
QDRANT_RETRY_BASE_DELAY=1.0
QDRANT_RETRY_MAX_DELAY=30.0

# --- Embeddings ---
EMBEDDING_MODEL=gemini-embedding-001
# Must match the collection's vector size. Changing this requires dropping and
# recreating the collection and re-embedding everything.
EMBEDDING_DIMENSION=3072
# Texts per Gemini embed_content call (API limit is 100). Independent of
# QDRANT_UPSERT_BATCH_SIZE.
EMBEDDING_BATCH_SIZE=100

# --- Chunking ---
# Affects how new pages are split; existing vectors are not re-chunked.
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
